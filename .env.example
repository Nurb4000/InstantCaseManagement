# Copy this file to ".env" and fill in real values.
# NEVER commit ".env" (see .gitignore).

FLASK_APP=run.py
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0

# S1: REQUIRED. A strong random key (>= 32 chars) used to sign sessions/CSRF.
# Generate one with:  python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=SET-A-LONG-RANDOM-SECRET-KEY-HERE

DATABASE_URL=sqlite:///instant_call_center.db
UPLOAD_FOLDER=uploads

# Set to true only on the very first deploy to auto-create the admin account.
ADMIN_CREATE=false

# S2: The admin password MUST be strong (>=12 chars, upper+lower+number+special,
# not a common password). If it is weak or unset, the admin account is NOT
# created and the app logs an error instructing you to set a strong one.
ADMIN_PASSWORD=SET-A-STRONG-ADMIN-PASSWORD-HERE

MARKETING_ENABLED=true
FLASK_RUN_PORT=5000

# Chat configuration - llama.cpp backends (optional)
# LLAMA_CPP_USER_URL=http://127.0.0.1:8080/v1/chat/completions
# LLAMA_CPP_STAFF_URL=http://127.0.0.1:8080/v1/chat/completions
